cabal-version:      3.0
name:               hosigraph
version:            0.2.0.0
synopsis:           An embedded database: the past as events, "now" as a Datalevin database
description:
  An embedded database for one process on one machine, on a local disk (the hosigraph design, formerly hosiDB):
  it keeps the past as frozen chunks of Create/Delete events and "now" (the khana) as a rebuildable instant.
  The khana ("now") is a Datalevin database (through the dtlv program or a resident JVM, which you bring along).
  The words it speaks (values, EDN, Datalog and pull syntax) are takka, which lives in this repository (takka/).
  What 0.1.0 wrote, every 0.1.x and 0.2.x reads. There is no C in the package. S3 is not in 0.2.
category:           Database
license:            BlueOak-1.0.0
license-file:       LICENSE
copyright:          2026 Hosigraph Contributors
build-type:         Simple
extra-doc-files:
  CHANGELOG.md
extra-source-files:
  README.md
  docs/*.md
  test/fixtures/world-0.1.0/expected.txt
  test/fixtures/world-0.1.0/events/manifest
  test/fixtures/world-0.1.0/events/tail.log
  test/fixtures/world-0.1.0/events/chunks/**/*.hosi
  test/fixtures/world-0.1.0/events/chunks/**/*.bin
  test/fixtures/world-0.1.0/events/chunks/**/*.idx
  test/fixtures/world-0.1.0/events/erase/*.bin

common shared
  default-language: GHC2021
  ghc-options:      -Wall -Wno-name-shadowing

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Hosigraph
    Hosigraph.Backfill
    Hosigraph.Bin
    Hosigraph.BinaryFuse
    Hosigraph.Chunk
    Hosigraph.Erase
    Hosigraph.Events
    Hosigraph.Khana
    Hosigraph.Khana.Dtlv
    Hosigraph.Khana.Sidecar
    Hosigraph.Event
    Hosigraph.Id
    Hosigraph.Manifest
    Hosigraph.Mphf
    Hosigraph.Probe
    Hosigraph.ReadCache
    Hosigraph.Regions
    Hosigraph.Sha256
    Hosigraph.Sync
    Hosigraph.Tail
    Hosigraph.WorldLock
    Hosigraph.WriteQueue
  build-depends:
      base        >=4.20 && <5
    , takka
    , aeson       >=2.0  && <2.3
    , array       >=0.5  && <0.6
    , bytestring  >=0.10 && <0.13
    , containers  >=0.6  && <0.8
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6
    , process     >=1.6  && <1.7
    , scientific  >=0.3  && <0.4
    , text        >=1.2  && <2.2
    , time        >=1.9  && <1.14
    , vector      >=0.12 && <0.14
  -- fsync (Sync) and flock (WorldLock) are the system's: unix has them; on Windows it is Win32
  if os(windows)
    build-depends: Win32 >=2.13 && <2.15
  else
    build-depends: unix >=2.8 && <2.9

executable hosigraph-demo
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base, hosigraph, takka, containers, directory, filepath, text, bytestring
  ghc-options:      -threaded -rtsopts

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:    base, hosigraph, takka, QuickCheck >=2.14, bytestring, containers, directory, filepath, process, text, time
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4"
