cabal-version:      2.4
name:               hosigraph
version:            0.0.1.0
synopsis:           hosigraph Phase 1 prototype (events, khana, MPHF)
description:
  A prototype of the hosigraph design (formerly hosiDB, v0.2.0-draft): an embedded database that keeps the
  past as frozen chunks of Create/Delete events and "now" (the khana) as a rebuildable instant.
  The khana ("now") is a Datalevin database (through dtlv or a resident JVM) or, for now, an in-process
  Haskell engine, reached through the separate package native-bridge (its path is given in cabal.project.local).
category:           Database
build-type:         Simple
extra-source-files:
  README.md
  docs/*.md
  cbits/hosi_sync.c

common shared
  default-language: Haskell2010
  -- scripts/build-ghc.sh builds with GHC's own default (GHC2021); cabal-version 2.4 cannot name
  -- that language, so the two extensions the code relies on are listed here.
  default-extensions: DeriveFunctor, FlexibleContexts
  ghc-options:      -Wall -Wno-name-shadowing

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Hosigraph
    Hosigraph.Bin
    Hosigraph.Chunk
    Hosigraph.Events
    Hosigraph.Khana
    Hosigraph.Khana.Dtlv
    Hosigraph.Khana.Sidecar
    Hosigraph.Event
    Hosigraph.Id
    Hosigraph.Manifest
    Hosigraph.Mphf
    Hosigraph.Probe
    Hosigraph.Sha256
    Hosigraph.Sync
    Hosigraph.Tail
  build-depends:
      base        >=4.14 && <5
    , native-bridge
    , aeson       >=2.0  && <2.3
    , array       >=0.5  && <0.6
    , bytestring  >=0.10 && <0.13
    , containers  >=0.6  && <0.8
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6
    , process     >=1.6  && <1.7
    , scientific  >=0.3  && <0.4
    , text        >=1.2  && <2.2
    , time        >=1.9  && <1.14
    , vector      >=0.12 && <0.14
  c-sources:
    cbits/hosi_sync.c
  cc-options:       -pthread -fPIC -w
  ld-options:       -pthread

executable hosigraph-demo
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    base, hosigraph, native-bridge, containers, directory, filepath, text, bytestring
  ghc-options:      -threaded -rtsopts

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:    base, hosigraph, native-bridge, QuickCheck >=2.14, bytestring, containers, directory, filepath, process, text, time
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N4"
